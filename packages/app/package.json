{
  "name": "@yeolo/app",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-firebase/analytics": "^25.1.0",
    "@react-native-firebase/app": "^25.1.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@tanstack/react-query": "^5.101.4",
    "@yeolo/common": "1.0.0",
    "expo": "~57.0.1",
    "expo-apple-authentication": "^57.0.1",
    "expo-auth-session": "^57.0.1",
    "expo-build-properties": "^57.0.1",
    "expo-crypto": "^57.0.1",
    "expo-linear-gradient": "^57.0.1",
    "expo-mail-composer": "^57.0.1",
    "expo-media-library": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "^57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-maps": "1.27.2",
    "react-native-safe-area-context": "^5.8.0",
    "react-native-svg": "^15.15.5",
    "react-native-webview": "^14.0.1"
  },
  "devDependencies": {
    "@react-native-community/cli": "^20.2.0",
    "@react-native/jest-preset": "^0.86.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29",
    "@types/react": "~19.2.2",
    "cross-fetch": "^4.1.0",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^8.0.0",
    "jest": "29.7.0",
    "jest-expo": "^57.0.2",
    "msw": "^2.15.0",
    "node-fetch": "2",
    "react-test-renderer": "^19.2.7",
    "test-renderer": "^1.2.0",
    "typescript": "~6.0.3",
    "undici": "^8.7.0",
    "whatwg-fetch": "^3.6.20"
  },
  "scripts": {
    "build:android:local": "dotenv -e .env.local -- eas build --platform android --profile production --local --output ./build/app.aab",
    "build:android:apk": "dotenv -e .env.local -- eas build --platform android --profile preview --local --output ./build/app.apk",
    "build:ios:local": "dotenv -e .env.local -- eas build --platform ios --profile production --local --output ./build/app.ipa",
    "eas-build-post-install": "yarn workspace @yeolo/common build",
    "start": "expo start",
    "android": "expo run:android",
    "android:build": "expo run:android --variant release",
    "ios": "expo run:ios",
    "ios:build": "expo run:ios --configuration Release",
    "web": "expo start --web",
    "lint": "tsc --noEmit",
    "test": "jest --watchAll=false --forceExit --testTimeout=10000"
  },
  "private": true
}
