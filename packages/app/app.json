{
  "expo": {
    "name": "여로",
    "slug": "yeolo",
    "scheme": "yeolo",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/branding/ios-blue-wordmark.png",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/branding/ios-blue-wordmark.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.yeolo-travel.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": ["yeolo"]
          }
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "여행 코스 경로 지도 표시 및 장소 위치 확인을 위해 위치 정보에 접근합니다."
      }
    },
    "android": {
      "package": "com.yeolo.app",
      "icon": "./assets/branding/android-blue-wordmark.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/android-adaptive-foreground.png",
        "backgroundImage": "./assets/branding/android-adaptive-background.png",
        "backgroundColor": "#54A9F5"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/branding/android-blue-wordmark.png"
    },
    "plugins": [
      "@react-native-firebase/app",
      [
        "expo-image-picker",
        {
          "photosPermission": "프로필 사진 등록 및 AI 여행 성향 분석을 위해 사진 보관함에 접근합니다.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [ 
        "expo-media-library",
        {
          "photosPermission": "프로필 사진 등록 및 AI 여행 성향 분석을 위해 사진 보관함에 접근합니다.",
          "savePhotosPermission": "생성한 여행 릴스 영상을 사진 보관함에 저장합니다.",
          "isAccessMediaLocationEnabled": true,
          "granularPermissions": ["photo"]
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          },
          "android": {
            "extraMavenRepos": [
              "https://sdk-download.airbridge.io/maven"
            ],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-dontwarn com.google.firebase.messaging.**"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c3f8b1df-1792-4bdb-8331-94e702cd105c"
      }
    },
    "owner": "sun819"
  }
}
