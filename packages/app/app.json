{
  "expo": {
    "name": "여로",
    "slug": "yeolo",
    "scheme": "yeolo",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yeolo-travel.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": ["yeolo"]
          }
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "여행 코스 경로 지도 표시 및 장소 위치 확인을 위해 위치 정보에 접근합니다."
      }
    },
    "android": {
      "package": "com.yeolo.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-firebase/app",
      [
        "expo-image-picker",
        {
          "photosPermission": "프로필 사진 등록 및 AI 여행 성향 분석을 위해 사진 보관함에 접근합니다.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [ 
        "expo-media-library",
        {
          "photosPermission": "프로필 사진 등록 및 AI 여행 성향 분석을 위해 사진 보관함에 접근합니다.",
          "savePhotosPermission": "분석된 일정을 내 기기에 저장합니다.",
          "isAccessMediaLocationEnabled": true,
          "granularPermissions": ["photo"]
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          },
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c3f8b1df-1792-4bdb-8331-94e702cd105c"
      }
    },
    "owner": "sun819"
  }
}
